<Window x:Class="ZZZBuffTracker.App.CaptureWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Capture / Detection" Width="1100" Height="850" MinWidth="850" MinHeight="650"
 Background="#12161E" Foreground="#E8EDF5" WindowStartupLocation="CenterOwner">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20">
   <TextBlock Text="CAPTURE / DETECTION" FontSize="24" FontWeight="Bold"/>
   <TextBlock Text="Chọn nguồn, Bắt đầu tracking, rồi hiệu chỉnh client area và ROI. Chưa có template ZZZ được kiểm chứng."
              TextWrapping="Wrap" Margin="0,8"/>
   <WrapPanel>
    <Button Content="Chọn cửa sổ / màn hình" Click="PickCapture" AutomationProperties.AutomationId="PickCapture"/>
    <Button Content="Bắt đầu tracking" Click="StartTracking"/>
    <Button Content="Chỉ manual" Click="ManualOnly"/>
    <Button Content="Mở screenshot" Click="OpenScreenshot"/>
    <Button Content="Mở replay.json" Click="OpenReplay"/>
    <Button Content="Đánh giá replay có nhãn" Click="EvaluateReplay"/>
   </WrapPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#91E4BC" Margin="0,8"/>
   <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#FFCF85" Margin="0,5"/>
   <WrapPanel>
    <Button Content="Nạp template pack" Click="LoadPack"/>
    <Button Content="Lưu pack thành file mới" Click="SavePack"/>
    <Button Content="Ghi replay 3 giây" Click="RecordReplay"/>
    <CheckBox x:Name="FreezePreview" Content="Giữ ảnh để hiệu chỉnh" Foreground="#E8EDF5" VerticalAlignment="Center" Margin="8"/>
   </WrapPanel>
   <TextBlock x:Name="PackText" Text="Chưa nạp pack: chỉ preview, không phát event nhận diện." TextWrapping="Wrap" Margin="0,8"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Toàn bộ frame (Gray8)"/>
     <Border Background="Black" Margin="0,6,12,6" Height="270"><Image x:Name="FrameImage" Stretch="Uniform"/></Border>
    </StackPanel>
    <StackPanel Grid.Column="1">
     <TextBlock Text="ROI trong client area"/>
     <Border Background="Black" Margin="0,6" Height="270"><Image x:Name="RoiImage" Stretch="Uniform"/></Border>
    </StackPanel>
   </Grid>
   <Grid Margin="0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Client X,Y,W,H [0..1]" VerticalAlignment="Center"/>
    <TextBox Grid.Column="1" x:Name="ClientText" Text="0,0,1,1" Margin="4"/>
    <TextBlock Grid.Row="1" Text="ROI X,Y,W,H [0..1]" VerticalAlignment="Center"/>
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RoiText" Text="0,0,1,1" Margin="4"/>
    <TextBlock Grid.Row="2" Text="Template / Subject ID" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
     <TextBox x:Name="TemplateIdText" Text="icon-1" Width="180" Margin="4"/>
     <TextBox x:Name="SubjectText" Text="demo-buff" Width="180" Margin="4"/>
     <ComboBox x:Name="KindBox" SelectedIndex="0" Width="130" Margin="4"><ComboBoxItem Content="Buff"/><ComboBoxItem Content="Character"/></ComboBox>
    </StackPanel>
    <TextBlock Grid.Row="3" Text="Character scope / UI scale" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
     <TextBox x:Name="CharacterText" Text="demo-character" Width="180" Margin="4"/>
     <TextBox x:Name="ScaleText" Text="1" Width="80" Margin="4"/>
     <TextBlock Text="Scope trống = mọi preset" VerticalAlignment="Center" Margin="6"/>
    </StackPanel>
    <TextBlock Grid.Row="4" Text="On / Off / Frames" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
     <TextBox x:Name="OnText" Text="0.94" Width="80" Margin="4"/>
     <TextBox x:Name="OffText" Text="0.70" Width="80" Margin="4"/>
     <TextBox x:Name="CountText" Text="3" Width="80" Margin="4"/>
    </StackPanel>
   </Grid>
   <WrapPanel>
    <Button Content="Xem ROI" Click="PreviewRoi"/>
    <Button Content="Thêm / thay template từ ROI" Click="AddTemplate"/>
    <Button Content="Test score trên ảnh hiện tại" Click="TestFrame"/>
    <Button Content="Pack mới" Click="NewPack"/>
   </WrapPanel>
   <TextBlock x:Name="DecisionsText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="Client area loại bỏ viền/titlebar; ROI tính trong client đó. Dùng dấu chấm cho số thập phân. UI scale là metadata: thay UI scale trong game phải hiệu chỉnh và tạo pack mới. Test score không gửi event."
              TextWrapping="Wrap" Foreground="#94A5BC" Margin="0,8"/>
  </StackPanel>
 </ScrollViewer>
</Window>
