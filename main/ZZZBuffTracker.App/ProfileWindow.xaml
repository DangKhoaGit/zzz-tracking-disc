<Window x:Class="ZZZBuffTracker.App.ProfileWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ZZZ Presets / Profiles" Width="1120" Height="740" MinWidth="850" MinHeight="600"
 Background="#12161E" Foreground="#E8EDF5" WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="PRESETS / PROFILES" FontSize="22" FontWeight="Bold"/>
   <WrapPanel Margin="0,12">
    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="CharacterId" Width="220" Margin="0,0,12,0" AutomationProperties.AutomationId="PresetList"/>
    <Button Content="Mới" Command="{Binding NewCommand}" AutomationProperties.AutomationId="NewPreset"/>
    <Button Content="Lưu preset" Click="SavePreset" AutomationProperties.AutomationId="SavePreset"/>
    <Button Content="Xóa" Click="DeletePreset" AutomationProperties.AutomationId="DeletePreset"/>
    <Button Content="Nạp lại" Command="{Binding ReloadCommand}" AutomationProperties.AutomationId="ReloadProfiles"/>
    <Button Content="Dùng nhân vật này" Command="{Binding ApplyCommand}" AutomationProperties.AutomationId="ApplyCharacter"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="1">
   <WrapPanel>
    <TextBlock Text="Character ID" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBox Text="{Binding CharacterId, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,16,0" AutomationProperties.AutomationId="CharacterId"/>
    <TextBlock Text="Tên nhân vật" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBox Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}" Width="240" AutomationProperties.AutomationId="CharacterName"/>
   </WrapPanel>
   <WrapPanel Margin="0,12">
    <Button Content="Thêm buff" Command="{Binding AddBuffCommand}"/>
    <Button Content="Bỏ buff đã chọn" Command="{Binding RemoveBuffCommand}"/>
    <Button Content="Giả lập CharacterChanged" Command="{Binding SimulateCharacterCommand}" AutomationProperties.AutomationId="SimulateCharacter"/>
   </WrapPanel>
   <TextBlock Text="Mỗi dòng là một buff của nhân vật này. Dùng icon buff trên HUD làm template; Subject ID trùng Buff ID, Character ID trùng preset. Rules import được giữ lại khi sửa buff." TextWrapping="Wrap" Foreground="#94A5BC" Margin="0,0,0,8"/>
  </StackPanel>
  <DataGrid x:Name="BuffGrid" Grid.Row="2" ItemsSource="{Binding Buffs}" SelectedItem="{Binding SelectedBuff}" AutoGenerateColumns="False"
   CanUserAddRows="False" Foreground="#152030" Background="White" AutomationProperties.AutomationId="BuffEditor">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Buff ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
    <DataGridTextColumn Header="Tên buff" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
    <DataGridTextColumn Header="Giây" Binding="{Binding DurationSeconds, ValidatesOnExceptions=True}" Width="65"/>
    <DataGridTextColumn Header="Max stack" Binding="{Binding MaxStacks, ValidatesOnExceptions=True}" Width="75"/>
    <DataGridTemplateColumn Header="Retrigger" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ComboBox ItemsSource="{Binding DataContext.RetriggerModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Retrigger, UpdateSourceTrigger=PropertyChanged}"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Mất tín hiệu" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ComboBox ItemsSource="{Binding DataContext.LossPolicies, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SignalLoss, UpdateSourceTrigger=PropertyChanged}"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridCheckBoxColumn Header="Stack refresh" Binding="{Binding StackRefreshesDuration}" Width="90"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <WrapPanel>
    <Button Content="Chọn file import" Click="PreviewImport" AutomationProperties.AutomationId="PreviewImport"/>
    <Button Content="Áp dụng import" Click="ApplyImport" AutomationProperties.AutomationId="ApplyImport"/>
    <Button Content="Export profile" Click="Export" AutomationProperties.AutomationId="ExportProfile"/>
   </WrapPanel>
   <TextBlock Text="{Binding ImportSummary}" TextWrapping="Wrap" Margin="0,10,0,4" Foreground="#FFD37F"/>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="ProfileMessage"/>
  </StackPanel>
 </Grid>
</Window>
