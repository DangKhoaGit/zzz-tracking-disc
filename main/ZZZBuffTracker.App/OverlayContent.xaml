<UserControl x:Class="ZZZBuffTracker.App.OverlayContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ZZZBuffTracker.App">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <local:SpacingConverter x:Key="Spacing"/>
  <!-- Original vector placeholder, not a game asset. Shared by image/hybrid preview and overlay. -->
  <DrawingImage x:Key="DemoDisc">
   <DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#203D43" Geometry="M 24,0 A 24,24 0 1 1 23.99,0 Z"/>
    <GeometryDrawing Brush="#91E4BC" Geometry="M 24,5 A 19,19 0 1 1 23.99,5 Z"/>
    <GeometryDrawing Brush="#17242D" Geometry="M 24,15 A 9,9 0 1 1 23.99,15 Z"/>
    <GeometryDrawing Brush="#91E4BC" Geometry="M 24,21 A 3,3 0 1 1 23.99,21 Z"/>
   </DrawingGroup></DrawingImage.Drawing>
  </DrawingImage>
 </UserControl.Resources>
 <StackPanel Opacity="{Binding Opacity}" HorizontalAlignment="Left" VerticalAlignment="Top">
  <StackPanel.LayoutTransform><ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/></StackPanel.LayoutTransform>
  <TextBlock Text="DEMO SNAPSHOT" Foreground="#FFD37F" FontWeight="Bold" Margin="4"
   Visibility="{Binding PreviewSamples, Converter={StaticResource Visible}}"/>
  <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="OverlayBuffs">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate>
    <StackPanel><StackPanel.Style><Style TargetType="StackPanel">
     <Setter Property="Orientation" Value="Vertical"/>
     <Style.Triggers><DataTrigger Binding="{Binding IsHorizontal}" Value="True">
      <Setter Property="Orientation" Value="Horizontal"/>
     </DataTrigger></Style.Triggers>
    </Style></StackPanel.Style></StackPanel>
   </ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="#ED202630" CornerRadius="8" Padding="12" Opacity="{Binding Value.Emphasis}"
     Margin="{Binding DataContext.Spacing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Spacing}}"
     ToolTip="{Binding Value.Name}">
     <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="270"/>
      <Style.Triggers><DataTrigger Binding="{Binding DataContext.ShowName, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
       <Setter Property="Width" Value="110"/>
      </DataTrigger></Style.Triggers>
     </Style></Border.Style>
     <StackPanel>
      <DockPanel>
       <Image Source="{StaticResource DemoDisc}" Width="36" Height="36" Margin="0,0,10,0"
        AutomationProperties.Name="Demo disc icon"
        Visibility="{Binding DataContext.ShowIcon, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"/>
       <TextBlock Text="{Binding Value.Name}" Foreground="#E8EDF5" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"
        Visibility="{Binding DataContext.ShowName, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"/>
      </DockPanel>
      <TextBlock Text="{Binding Value.Status}" Foreground="#91E4BC" Margin="0,6,0,4"/>
      <ProgressBar Value="{Binding Value.Progress}" Maximum="1" Height="5" Margin="0,0,0,7">
       <ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers>
        <DataTrigger Binding="{Binding Value.IsUncertain}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers></Style></ProgressBar.Style>
      </ProgressBar>
      <WrapPanel>
       <TextBlock Text="{Binding Value.Countdown}" Foreground="#E8EDF5" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Value.Stacks, StringFormat=Stack: {0}}" Foreground="#BCC8D9" Margin="12,0,0,0"/>
      </WrapPanel>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </StackPanel>
</UserControl>
